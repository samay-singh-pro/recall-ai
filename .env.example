# LLM (swap provider/model here — no code changes)
LLM_PROVIDER=gemini            # gemini | groq | openrouter | ollama
LLM_MODEL=gemini/gemini-2.0-flash
EMBEDDING_MODEL=gemini/text-embedding-004
GEMINI_API_KEY=
GROQ_API_KEY=

# Database (swap to postgresql+asyncpg://... later)
DATABASE_URL=sqlite+aiosqlite:///./recall.db
VECTOR_STORE=local             # local | pgvector

# File storage: Supabase Storage (Dashboard -> Project Settings -> API)
SUPABASE_URL=                  # https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=           # secret key (sb_secret_...): server only, never in the frontend
SUPABASE_BUCKET=memories       # private bucket (Dashboard -> Storage -> New bucket)
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_MEMORY=5

# Auth
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# LLM (swap provider/model here — no code changes)
LLM_PROVIDER=gemini            # gemini | groq | openrouter | ollama
LLM_MODEL=gemini/gemini-2.0-flash
EMBEDDING_MODEL=gemini/text-embedding-004
GEMINI_API_KEY=
GROQ_API_KEY=

# Database (swap to postgresql+asyncpg://... later)
DATABASE_URL=sqlite+aiosqlite:///./recall.db
VECTOR_STORE=local             # local | pgvector

# Auth
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
